{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "./hooks/subagent-models.py",
        "matcher": "Task|Subagent",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "./hooks/subagent-models.py",
        "timeout": 10
      }
    ]
  }
}
